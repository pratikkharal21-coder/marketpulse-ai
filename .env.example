GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GMAIL_ADDRESS=youraddress@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
RECIPIENT_EMAIL=youraddress@gmail.com

# Optional: auto-post the top thread(s) each run to X instead of email-only drafts. Get these
# from developer.x.com -> your app -> "Keys and tokens" (needs Read+Write app permissions,
# regenerate the access token/secret AFTER setting that or they'll still be read-only). Leave
# unset to keep the current email-only behavior -- nothing else changes.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# X's free tier caps writes at 500 posts/month account-wide, and every tweet in a thread counts
# separately. Default here is a conservative 480; check your actual plan at
# developer.x.com/en/portal/products and raise it if you're not on the free tier.
X_MONTHLY_POST_CAP=480
# How many threads (not tweets) to auto-post per run -- the rest still get emailed as drafts.
X_MAX_THREADS_PER_RUN=1

# Optional: one extra sarcastic/mocking "meme take" thread per run, reacting to the day's
# top-ranked story, with an original cartoon illustration (not scraped/copied -- see
# memeart.py). Additive to the normal threads/deep dives, never a replacement. Set to false to
# turn off.
MEME_MODE_ENABLED=true

# Optional: a separate "lighter side" digest built from FEEDS["humor"] (satire/comedy sources
# like The Onion) -- bypasses the relevance-scoring triage model entirely and gets its own
# illustrated image per item (free Pollinations.ai background art + a drawn caption/stat
# overlay, see satire_image.py). Additive to every other section. Set to false to turn off.
SATIRE_DIGEST_ENABLED=true
# How many satire items to generate per run.
MAX_SATIRE_ITEMS=2

# Optional tuning (defaults shown) - free tier Groq models
TRIAGE_MODEL=qwen/qwen3.8-27b
GENERATE_MODEL=qwen/qwen3.8-27b

# Triage: a headline must score >= this on relevance OR impact (0-10 scale) to survive
TRIAGE_RELEVANCE_THRESHOLD=6
# Max stories triage keeps as candidates for generation, after scoring/ranking
MAX_STORIES_ANALYZED=10
# How many short threads to generate per run (one per top story, in "Today's Threads")
MAX_SHORT_THREADS=5
# How many deep-dive threads to generate per run (overlaps with the top short threads by design)
MAX_LONGFORM_STORIES=2
# How far back (hours) to pull headlines from each RSS feed
LOOKBACK_HOURS=8
# If a draft's self-reported expected_engagement (0-10) is below this, retry once with a
# critique asking for a sharper hook; keeps whichever draft scores higher. Set to 0 to disable.
REGEN_THRESHOLD=6
